# Copia este archivo a .env y complétalo. .env NUNCA se sube a GitHub.
#   Ubuntu:  cp .env.example .env
#   Windows: copy .env.example .env

# --- Telegram (obligatorio) -------------------------------------------------
# Token que entrega @BotFather
TELEGRAM_TOKEN=
# IDs autorizados separados por coma. Vacío la primera vez: el bot te dice tu ID.
TELEGRAM_USUARIOS=

# --- Equipo (obligatorio) ---------------------------------------------------
# Ruta absoluta de la bóveda. En Windows con barras normales: C:/Users/<usuario>/Boveda
VAULT_PATH=
# pc-casa o laptop: distingue los equipos en el latido y en /estado
SERVIDOR_NOMBRE=pc-casa
TZ=Europe/Madrid

# --- Web local (fase 2) -------------------------------------------------------
# Ubuntu: 127.0.0.1 (o la IP de la red local). Windows: 0.0.0.0
LAN_IP=127.0.0.1
WEB_PORT=8080

# Ubuntu: usuario con el que corre core (hub.sh lo toma de `id -u`/`id -g`; solo si usas
# docker compose directo y tu usuario no es el 1000). En Windows no hace falta.
# HUB_UID=1000
# HUB_GID=1000

# Solo si el otro equipo se apagó de golpe y su latido no caducó. Volver a 0 después.
FORZAR_ARRANQUE=0

# --- Servicios opcionales -------------------------------------------------
# consulta = OpenClaw (día 5). llm-local = Ollama/qwen, dormido en el MVP (no activar sin
# poner también llm_local.activo: true en config.yaml). Ejemplo: consulta
COMPOSE_PROFILES=

# --- OpenClaw (día 5) ---------------------------------------------------------
# Generar con ./hub.sh token
OPENCLAW_GATEWAY_TOKEN=
OPENROUTER_API_KEY=

# --- Imágenes (día 4) -----------------------------------------------------------
# Orden de la cadena en config.yaml: chatgpt (OpenClaw) -> cloudflare -> tensorart.
# MVP: solo chatgpt; cloudflare y tensorart desactivados (activo: false) hasta después del MVP.
# Cloudflare Workers AI: ID de cuenta y token con permiso "Workers AI"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# tensor.art (TAMS): endpoint y app id de tu aplicación. La clave privada NO va aquí:
# guárdala en datos/tensorart_private_key.pem (o indica otra ruta dentro del contenedor)
TENSORART_ENDPOINT=
TENSORART_APP_ID=
TENSORART_PRIVATE_KEY_PATH=

# --- Voz (fase 2) ------------------------------------------------------------
WHISPER_MODELO=small
